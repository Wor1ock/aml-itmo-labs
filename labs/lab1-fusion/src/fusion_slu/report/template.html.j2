              <td class="num">{{ row.f1[head][0] | pct }} <span class="muted">± {{ row.f1[head][1] | pct }}</span></td>
            {% endfor %}
            <td class="num">{{ row.joint[0] | pct }}</td>
            <td class="num">{% if row.key in metadata %}{{ "{:,}".format(metadata[row.key].parameters|int).replace(",", " ") }}{% else %}—{% endif %}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% if 'comparison' in figures %}
    <figure class="figure"><img src="{{ figures.comparison }}" alt="Сравнение моделей">
      <figcaption>Рис. 5. Exact match и weighted F1 по слотам. У majority-бейзлайна std = 0, потому что он не обучается.</figcaption>
    </figure>
    {% endif %}
    {% if 'curves' in figures %}
    <figure class="figure"><img src="{{ figures.curves }}" alt="Кривые обучения">
      <figcaption>Рис. 6. Кривые обучения лучшего fusion-запуска: loss и accuracy по эпохам (пунктир — train).</figcaption>
    </figure>
    {% endif %}

    <h3>5.1. Где модель ошибается</h3>
    <div class="grid-3">
      {% for head in heads %}
      <div>
        <h4>{{ head }}</h4>
        <div class="table-wrap">
          <table>
            <thead><tr><th>true</th><th>pred</th><th class="num">n</th></tr></thead>
            <tbody>
            {% for pair in confusions[head][:8] %}
              <tr><td>{{ pair.true }}</td><td>{{ pair.predicted }}</td><td class="num">{{ pair.count }}</td></tr>
